{
  "type": "object",
  "additionalProperties": false,
  "required": ["duration_s", "onscreen_text", "scores", "fixes", "critical", "strengths", "ai_template"],
  "properties": {
    "duration_s": { "type": "number", "description": "Total length of the video in seconds, as watched." },
    "onscreen_text": {
      "type": "array", "maxItems": 12, "items": { "type": "string" },
      "description": "Up to 12 text phrases seen on screen, copied verbatim with diacritics."
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_fidelity", "concept_wow", "motion_craft", "design_typography", "finish_texture", "sound_sync", "technical"],
      "properties": {
        "style_fidelity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "concept_wow": { "type": "integer", "minimum": 1, "maximum": 10 },
        "motion_craft": { "type": "integer", "minimum": 1, "maximum": 10 },
        "design_typography": { "type": "integer", "minimum": 1, "maximum": 10 },
        "finish_texture": { "type": "integer", "minimum": 1, "maximum": 10 },
        "sound_sync": { "type": "integer", "minimum": 1, "maximum": 10 },
        "technical": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "fixes": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t_s", "dimension", "observed", "change", "impact", "wow"],
        "properties": {
          "t_s": { "type": "number", "description": "Second where the problem is most visible." },
          "dimension": { "type": "string", "enum": ["style_fidelity", "concept_wow", "motion_craft", "design_typography", "finish_texture", "sound_sync", "technical"] },
          "observed": { "type": "string", "description": "What is wrong, as seen or heard." },
          "change": { "type": "string", "description": "Concrete change with numbers: easing, frames, px, colours, seconds." },
          "impact": { "type": "string", "enum": ["high", "medium", "low"] },
          "wow": { "type": "boolean", "description": "true when the fix raises the wow factor, not just polish." }
        }
      }
    },
    "critical": { "type": "array", "items": { "type": "string" }, "description": "Generic/AI-template look, broken Vietnamese, fallback fonts, spec failures." },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "ai_template": { "type": "boolean", "description": "true when the video reads as a generic AI template." }
  }
}
